rules_version = '2';

// Firestore security rules for Infinity Engineering Stock
service cloud.firestore {
  match /databases/{database}/documents {

    // Only signed-in users can read or write stock data.
    function isSignedIn() {
      return request.auth != null;
    }

    match /stock_entries/{entryId} {
      // Authenticated users can read all stock entries (shared inventory).
      allow read: if isSignedIn();

      // Only authenticated users can create entries, and the entry's
      // createdBy must match the requesting user's uid.
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;

      // Updates and deletes are restricted to the original creator.
      // Remove the createdBy check if any signed-in user should edit/delete.
      allow update: if isSignedIn()
        && resource.data.createdBy == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    // Deny all other collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
